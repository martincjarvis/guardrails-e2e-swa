{
  "name": "contoso-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "app"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && markdownlint-cli2 && cspell lint \"**/*\" && npm run lint:secrets && npm run lint:bicep",
    "lint:bicep": "bash scripts/bicep-format-check.sh",
    "lint:secrets": "secretlint \"**/*\" --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore",
    "typecheck": "npm run -ws build",
    "test": "bash scripts/test-all.sh",
    "test:app": "npm run -ws test",
    "test:api": "dotnet test api/ContosoNotes.slnx",
    "verify": "bash scripts/verify.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "^1.18.8",
    "@secretlint/secretlint-rule-pattern": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "c8": "^12.0.0",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-rule-relative-links": "^5.1.2",
    "prettier": "^3.9.6",
    "secretlint": "^13.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
