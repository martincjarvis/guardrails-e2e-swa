<?xml version="1.0" encoding="utf-8"?>
<!-- Coverlet XPlat Code Coverage scope: product assembly in, test assembly
     and the source-generated WorkerExtensions out, so the denominator matches
     what the team ships. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Program.cs,**/*.g.cs,**/WorkerExtensions/**</ExcludeByFile>
          <Exclude>[*Api.Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
